# Copie para deploy/.env (ou passe com --env-file). Sem segredos: a POC não usa credencial nenhuma.
# Porta publicada só em 127.0.0.1; o Caddy da VPS disca 127.0.0.1:8094.
PORT=8094

# O Caddy roda na rede do host e chega por 127.0.0.1:8094; o app enxerga a origem como o
# gateway da bridge de ingresso (172.30.0.0/24). A rede interna backend usa 172.30.1.0/24.
# Ambas são fixas no docker-compose.yml e estão livres na VPS (as redes Docker de lá usam
# 172.17 a 172.29 em /16 e 172.30.93 a 172.30.95 em /24). O gateway fica fora de INTERNAL_NETS
# na prática: TRUSTED_PROXIES vence.
TRUSTED_PROXIES=172.30.0.1/32
INTERNAL_NETS=172.30.0.0/24,172.30.1.0/24

RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=30
